{
  "$comment": "Single source of truth for installment-plan cases (RN-03, RN-04, D-09, D-10). Consumed by Vitest (shared/domain/installments.ts) and pgTAP (private.calc_installments). Amounts are integer colones.",
  "cases": [
    {
      "id": "equal-split-no-down-payment",
      "input": { "total": 30000, "downPayment": 0, "months": 3, "saleDate": "2026-11-02" },
      "expected": {
        "installments": [
          { "number": 1, "dueDate": "2026-12-02", "amount": 10000 },
          { "number": 2, "dueDate": "2027-01-02", "amount": 10000 },
          { "number": 3, "dueDate": "2027-02-02", "amount": 10000 }
        ]
      }
    },
    {
      "id": "rounding-remainder-goes-to-last",
      "input": { "total": 25000, "downPayment": 0, "months": 3, "saleDate": "2026-11-02" },
      "expected": {
        "installments": [
          { "number": 1, "dueDate": "2026-12-02", "amount": 8300 },
          { "number": 2, "dueDate": "2027-01-02", "amount": 8300 },
          { "number": 3, "dueDate": "2027-02-02", "amount": 8400 }
        ]
      }
    },
    {
      "id": "with-down-payment-three-months",
      "input": { "total": 38500, "downPayment": 10000, "months": 3, "saleDate": "2026-11-02" },
      "expected": {
        "installments": [
          { "number": 1, "dueDate": "2026-12-02", "amount": 9500 },
          { "number": 2, "dueDate": "2027-01-02", "amount": 9500 },
          { "number": 3, "dueDate": "2027-02-02", "amount": 9500 }
        ]
      }
    },
    {
      "id": "with-down-payment-two-months",
      "input": { "total": 26000, "downPayment": 5000, "months": 2, "saleDate": "2026-11-02" },
      "expected": {
        "installments": [
          { "number": 1, "dueDate": "2026-12-02", "amount": 10500 },
          { "number": 2, "dueDate": "2027-01-02", "amount": 10500 }
        ]
      }
    },
    {
      "id": "single-installment",
      "input": { "total": 9500, "downPayment": 0, "months": 1, "saleDate": "2026-11-02" },
      "expected": {
        "installments": [{ "number": 1, "dueDate": "2026-12-02", "amount": 9500 }]
      }
    },
    {
      "id": "month-end-clamps-to-last-day",
      "input": { "total": 12000, "downPayment": 0, "months": 1, "saleDate": "2026-01-31" },
      "expected": {
        "installments": [{ "number": 1, "dueDate": "2026-02-28", "amount": 12000 }]
      }
    },
    {
      "id": "due-dates-anchor-on-sale-day-not-previous-due",
      "input": { "total": 15000, "downPayment": 0, "months": 3, "saleDate": "2026-11-30" },
      "expected": {
        "installments": [
          { "number": 1, "dueDate": "2026-12-30", "amount": 5000 },
          { "number": 2, "dueDate": "2027-01-30", "amount": 5000 },
          { "number": 3, "dueDate": "2027-02-28", "amount": 5000 }
        ]
      }
    },
    {
      "id": "legacy-balance-with-first-due-date",
      "input": {
        "total": 20000,
        "downPayment": 0,
        "months": 2,
        "saleDate": "2026-09-15",
        "firstDueDate": "2026-10-15"
      },
      "expected": {
        "installments": [
          { "number": 1, "dueDate": "2026-10-15", "amount": 10000 },
          { "number": 2, "dueDate": "2026-11-15", "amount": 10000 }
        ]
      }
    },
    {
      "id": "rejects-zero-installment-after-rounding",
      "input": { "total": 200, "downPayment": 0, "months": 3, "saleDate": "2026-11-02" },
      "expected": { "error": "term_too_long" }
    },
    {
      "id": "rejects-down-payment-equal-to-total",
      "input": { "total": 10000, "downPayment": 10000, "months": 2, "saleDate": "2026-11-02" },
      "expected": { "error": "invalid_down_payment" }
    },
    {
      "id": "rejects-term-over-three-months",
      "input": { "total": 40000, "downPayment": 0, "months": 4, "saleDate": "2026-11-02" },
      "expected": { "error": "invalid_term" }
    }
  ]
}
