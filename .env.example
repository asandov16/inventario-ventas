# Copy to web/.env.local for local development. Never commit real values.
# Only PUBLIC values may use the VITE_ prefix: they end up in the browser bundle.

# Local Supabase (printed by `pnpm db:start`)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Generic installed-app name (D-19). The business name itself lives in the database.
VITE_APP_NAME=Inventario y Ventas

# NEVER put the service role key, database passwords or tokens in any VITE_ variable.
