{
  "name": "inventario-ventas",
  "private": true,
  "description": "Inventory and sales PWA for a small family business (React + Supabase).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "supabase start && pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "eslint . --max-warnings=0",
    "lint:sql": "python3 -m sqlfluff lint supabase/migrations supabase/seed.sql supabase/bootstrap",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:scan": "gitleaks git --redact --verbose .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "gen:types": "supabase gen types typescript --local --schema public > web/src/shared/api/database.types.ts",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "supabase": "3.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.16.1"
}
